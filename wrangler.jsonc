{
	// ---------------------------------------------------------------------------
	// v2 on Cloudflare Workers, via the OpenNext adapter. Onkar, 2026-09-01.
	//
	// v2 is NOT a static site and cannot be uploaded like v1 was: /api/enquiry,
	// the two admin routes and /admin are server-rendered, and that server side
	// is the whole point of the rebuild — it is what stops the form claiming a
	// send that never happened. So this is a Worker, not a Pages upload.
	//
	// THE NAME IS THE LIVE SITE. Onkar, 2026-09-01, once the SMTP variables were
	// set on the worker: this deploys ONTO `3stechnology`, the worker serving
	// 3stechnology.in. Every push to main now replaces what the public sees.
	// It was `3stechnology-v2` for exactly one day, deliberately, so v2 could
	// stand up beside v1 without touching it — Cloudflare's build is bound to
	// `3stechnology` and flagged the mismatch, and this is the decision that
	// answers it rather than a rename for tidiness.
	//
	// The way back is not this file: v1 is on branch `v1` and tag
	// `v1-live-2026-09-01` (7c787c7), and Cloudflare keeps previous versions —
	// roll back in the dashboard, faster than any git operation.
	// ---------------------------------------------------------------------------
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "3stechnology",
	"main": ".open-next/worker.js",

	// Held one day behind today's date on purpose: the installed workerd is
	// 1.20260828.1 and rejects a compatibility_date it does not yet know.
	"compatibility_date": "2026-08-28",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	// NON-SECRET configuration, in the repo ON PURPOSE.
	//
	// `wrangler deploy` replaces the worker's plaintext vars with whatever this
	// file declares — anything typed into the dashboard as a *Variable* is wiped
	// by the next deployment. (Secrets are NOT touched, which is why SMTP_USER and
	// SMTP_PASS stay where they are.) On 2026-09-01 that is exactly what happened:
	// the variables were set, the deploy landed, and /api/enquiry came back
	// {"email":"not-configured"} because SMTP_HOST no longer existed.
	//
	// None of these three is a credential. The address is printed on the contact
	// page, and the host and port are public knowledge. SMTP_PASS, ADMIN_PASSWORD
	// and SUPABASE_KEY must NEVER appear here — this file is committed to a repo
	// the client can read.
	"vars": {
		"SMTP_HOST": "smtp.gmail.com",
		"SMTP_PORT": "465",
		"ENQUIRY_TO": "3stechnology2024@gmail.com"
	},

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// next/image optimisation runs on the Workers Images binding.
	"images": {
		"binding": "IMAGES"
	},

	"observability": {
		"enabled": true
	}

	// No R2 incremental cache binding, deliberately. Every page here is either
	// static at build time or force-dynamic; there is no ISR and nothing to
	// revalidate, so the cache bucket the template suggests would be an empty
	// resource somebody has to create and pay attention to. Add it the day a
	// route starts revalidating.
}
