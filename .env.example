# Server-only. No NEXT_PUBLIC_ prefix — these must never reach the browser.

# Supabase, for storing enquiries and reading the /admin inbox.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon or service key — the long eyJ... JWT>

# The /admin back office. Without this, /admin says so and stays shut.
ADMIN_PASSWORD=<choose a long one>
# Optional: rotate this to invalidate every existing admin session at once.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email. This is what makes "Send enquiry" actually deliver: the server mails
# the enquiry to the desk the moment the buyer presses the button.
#
#   SMTP_USER  = the account that SENDS. Use a dedicated throwaway Gmail, never
#                the company inbox — an app password on the real account would
#                grant full mailbox access to anything holding this file.
#   ENQUIRY_TO = the inbox enquiries LAND in. The real company address.
#
# On the SENDING account: 2-Step Verification must be ON, then
# Google Account > Security > App passwords > generate > 16 chars, no spaces.
# Confirm it works with:  npm run mail:check -- send
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=smrutisingh30@gmail.com
SMTP_PASS=undmyecldikmmcan
ENQUIRY_TO=3stechnology2024@gmail.com
